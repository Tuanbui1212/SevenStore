# ==========================================
# SevenStore Backend Environment Variables
# ==========================================

PORT=5000

# MongoDB Connection String (Atlas or Local)
MONGO_URI=mongodb+srv://<username>:<password>@sevenstore.xmkf4si.mongodb.net/SevenStore?retryWrites=true&w=majority

# JWT Authentication
ACCESS_TOKEN_SECRET=your_super_secret_jwt_access_token_key_here
JWT_EXPIRES_IN=1h

# VNPay Payment Gateway (Sandbox / Production)
VNP_TMNCODE=your_vnpay_tmn_code
VNP_HASHSECRET=your_vnpay_hash_secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURNURL=http://localhost:3000/my-orders
